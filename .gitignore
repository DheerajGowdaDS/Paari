# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.log

# Environment files
.env
# .env.example is tracked (negated below)
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Test / probe artifacts (Phase-1 cleanup)
tests/_test_*.db
_test_*.db
*-test.db

# Runtime artifacts (regenerate locally)
paari.db
paari.db-shm
paari.db-wal

# JWT signing keys (gitignored; regenerated by seed.py)
# private key must NEVER be committed; public key is safe
paari/authn/keys/*_private.pem
paari/authn/keys/*_private.*

# Local environment with secrets
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# mypy cache
.mypy_cache/

# pytest cache
.pytest_cache/

# egg/bytecompile
*.egg-info/
*.egg

# editor/OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# debug / probe artifacts
*.log
*.tmp
*.temp
.cache/

# build outputs (frontend)
.next/
node_modules/.cache/

# docs with live secrets (generated; not source)
*.db.bak-*

# anything that looks like a credential file
*_credentials.pyc


# mangled temp file from pytest/unicode path
C*/Users*AppData*/Local*Temp*/pytest_out.txt


# local runtime / tooling artifacts (staging to GitHub)
CUsers*
*Usersgowda*
NUL
push_github.ps1
.server_pid
.ruff_cache/
.kilo/
pytest_*.txt
*_audit.txt
mypy_*.txt
pytest_summary.txt
pytest_collect.txt
# frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
