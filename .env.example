# Paari — environment configuration
# Copy to .env and fill in values.

# ── LLM ────────────────────────────────────────────────────────────
PAARI_LLM_BASE_URL=https://router.bynara.id/v1
PAARI_LLM_API_KEY=
PAARI_LLM_MODEL=stepfun-3.7-flash
PAARI_LLM_TIMEOUT_S=30.0

# ── Database ────────────────────────────────────────────────────────
PAARI_DB_URL=sqlite+aiosqlite:///paari.db
# For Postgres: postgresql+asyncpg://paari:paari_dev_password@localhost:5432/paari
PAARI_INIT_DB=true
PAARI_REDIS_URL=redis://localhost:6379/0

# ── Identity ────────────────────────────────────────────────────────
PAARI_JWT_ISSUER=paari-platform
PAARI_JWT_EXPIRE_SECONDS=900

# ── Platform limits ─────────────────────────────────────────────────
PAARI_MAX_AUTONOMOUS_TRANSACTION_PAISE=5000000
PAARI_PAYMENT_SESSION_TTL_SECONDS=600
PAARI_MAX_PAYMENT_RETRIES=3

# ── Demo merchant seed ──────────────────────────────────────────────
PAARI_DEMO_MERCHANT_NAME=Demo Shoes
PAARI_DEMO_MERCHANT_AUTONOMOUS_LIMIT_PAISE=2000000

# ── Dashboard ───────────────────────────────────────────────────────
PAARI_DASHBOARD_SESSION_SECRET=change-me
PAARI_DASHBOARD_USER=merchant@demo.local
PAARI_DASHBOARD_PASSWORD=demo
PAARI_REVIEW_SLA_HOURS=4

# ── Server ──────────────────────────────────────────────────────────
PAARI_HOST=127.0.0.1
PAARI_PORT=8000

# ── Commerce adapter (Shopify) ──────────────────────────────────────
PAARI_SHOPIFY_MODE=stub                    # stub | live
PAARI_SHOPIFY_DOMAIN=paari-demo-store.myshopify.com
PAARI_SHOPIFY_API_VERSION=2025-01
PAARI_SHOPIFY_ADMIN_TOKEN_VAR=SHOPIFY_ADMIN_ACCESS_TOKEN
PAARI_SHOPIFY_CLIENT_SECRET_VAR=SHOPIFY_CLIENT_SECRET
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_SECRET=
PAARI_STOREFRONT_MCP_URL=https://{your-store}.myshopify.com/api/mcp

# ── Store context caching ──────────────────────────────────────────
PAARI_STORE_CONTEXT_TTL_SECONDS=900        # 15 min
PAARI_STORE_POLICY_TTL_HOURS=24

# ── Webhooks ────────────────────────────────────────────────────────
PAARI_WEBHOOK_BASE_URL=                    # e.g. https://abc.ngrok-free.app
PAARI_WEBHOOK_TOPIC_ORDERS=orders/create,orders/updated,orders/delete
PAARI_WEBHOOK_TOPIC_INVENTORY=inventory_levels/update
PAARI_WEBHOOK_WORKERS=1

# ── Razorpay (Test Mode) ───────────────────────────────────────────
# Test keys — secret shown only at generation; rotate after demo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
